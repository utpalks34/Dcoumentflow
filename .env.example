# Copy to .env and fill in. Never commit .env (docs/06_LLM_Instructions.md, Hard rule 8).

DATABASE_URL=postgresql://docflow:docflow@localhost:5432/docflow
REDIS_URL=redis://localhost:6379/0

# Model gateway credentials. TR-MOD-08: only synthetic, public or explicitly
# permitted documents may go to hosted models.
TIER1_API_KEY=
TIER2_API_KEY=

# live | record | replay — CI must always run replay-only.
GATEWAY_MODE=replay

ENVIRONMENT=development
